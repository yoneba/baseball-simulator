{
	"name": "baseball-simulator",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "bun@1.4.4",
	"engines": {
		"bun": ">=1.4.4"
	},
	"scripts": {
		"preinstall": "case \"$npm_config_user_agent\" in bun/*) ;; *) echo 'This project uses bun. Run `bun install` instead.' >&2; exit 1 ;; esac",
		"dev": "vite",
		"build": "bun --bun tsc -b && bun --bun vite build",
		"lint": "oxlint",
		"test": "bun test",
		"calibrate": "bun scripts/calibrate.ts",
		"preview": "bun run build && vite preview",
		"deploy": "bun run build && wrangler deploy",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^8.5.1"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.66.0",
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"oxlint": "^1.88.0",
		"typescript": "~6.0.3",
		"vite": "^8.3.4",
		"wrangler": "^4.155.0"
	}
}